cabal-version:      3.4
name:               bazalt-studio
version:            0.18.0.0
synopsis: Modeling studio for Bazalt
-- description:
-- bug-reports:
license:            Apache-2.0
author:              Christophe Combelles
maintainer:          ccomb@free.fr
-- copyright:
-- category:
-- extra-source-files:  CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/ccomb/bazalt

executable studio
    main-is:          Main.hs
    hs-source-dirs:   src
  -- other-extensions:
    ghc-options: -Wall -O -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.17
        , aeson >= 2.1
        , bytestring
        , containers
        , http-types
        , bazalt-message
        , mtl
        , optparse-applicative
        , scientific
        , text
        , time
        , unordered-containers
        , uuid
        , vector
        , wai
        , wai-websockets
        , warp
        , websockets
  -- hs-source-dirs:
    default-language:    GHC2021
