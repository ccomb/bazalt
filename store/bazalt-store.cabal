cabal-version:      3.4
name:               bazalt-store
version:            0.2.0.0
synopsis: Main event store for Bazalt
-- description:
-- bug-reports:
license:            Apache-2.0
author:              Christophe Combelles
maintainer:          ccomb@free.fr
-- copyright:
-- category:
extra-source-files: CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/ccomb/bazalt

executable store
    main-is:          Main.hs
    hs-source-dirs:   src
    ghc-options: -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >=4.16
        , aeson >= 2.1
        , bytestring
        , containers
        , http-types
        , bazalt-message
        , optparse-applicative
        , scientific
        , text
        , time
        , unordered-containers
        , uuid
        , vector
        , wai
        , wai-websockets
        , warp
        , websockets
    default-language: GHC2021
