cabal-version:      3.4
name:               bazalt-ident
version:            0.2.0.0
synopsis: Bazalt microservice for the identification needs
-- description:
-- bug-reports:
license:            Apache-2.0
author:             Christophe Combelles
maintainer:         ccomb@free.fr

-- A copyright notice.
-- copyright:
-- category:
extra-source-files: CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/ccomb/bazalt

executable ident
    main-is:          Main.hs
    hs-source-dirs:   src
    ghc-options: -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.17
        , aeson >= 2.1
--        , bytestring
        , containers
--        , http-types
        , bazalt-message
--        , mtl
        , optparse-applicative
--        , scientific
        , text
        , time
--        , unordered-containers
        , uuid
--        , vector
        , wai
        , wai-websockets
        , warp
        , websockets

    default-language: GHC2021
